# DOK'PÉYI — Exemple de fichier .env
# Copiez ce fichier en .env.local et remplissez les valeurs réelles.
# Ne mettez JAMAIS de vrais secrets dans ce fichier.

# ── Mots de passe admin ──────────────────────────────────────
ADMIN_PASS_ALLAN=changeme
ADMIN_PASS_YONEL=changeme
ADMIN_PASS_MARVIN=changeme
ADMIN_PASS_REDAC=changeme

# ── IA ───────────────────────────────────────────────────────
CLAUD_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Dok'péyi <noreply@dok-peyi.fr>
EMAIL_ADMIN=contact@dok-peyi.fr

# ── Webhooks / callbacks ─────────────────────────────────────
DOK_WEBHOOK_SECRET=changeme
MOMO_CALLBACK_TOKEN=changeme

# ── Firebase (Realtime DB EU-west1) ──────────────────────────
FIREBASE_DATABASE_URL=https://your-project.europe-west1.firebasedatabase.app

# ── URL de base (sans slash final) ──────────────────────────
NEXT_PUBLIC_BASE_URL=https://dok-peyi.vercel.app

# Note : PAYPAL_EMAIL n'est pas une variable d'environnement.
# L'adresse PayPal Business est actuellement hardcodée dans service.js.
